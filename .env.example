# Copy this file to `.env` in the project root. It is loaded automatically by
# manage.py, WSGI and ASGI. You can also export these variables in your shell.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret

# Optional: comma-separated hosts for LAN / phone testing, e.g. 192.168.1.10
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10

# Optional face-assisted 1:1 verification (requires models/ in the project root)
# IRIS_FACE_ASSIST_ENABLED=true
# IRIS_FACE_ASSIST_MAX_IRIS_DISTANCE=0.46
# IRIS_FACE_ASSIST_MIN_SIMILARITY=0.60
